ifeq ($(OS),Windows_NT)
	UTILS_BIN_PATH = \MinGW\msys\1.0\bin\
	
	EXT_EXEC = exe
	EXT_SOBJ = dll
	EXT_UTILS = .$(EXT_EXEC)
	
	FRAMEWORK_EXEC_FLAGS = -DREGION_BUILD
	TARGET_FLAGS = -shared -DREGION_BUILD
	REGION_TEST_SO_FLAGS = -shared -DREGION_BUILD

	PATH_SEPARATOR = \\
else
	UTILS_BIN_PATH =

	EXT_EXEC =
	EXT_SOBJ = so
	EXT_UTILS = 

	FRAMEWORK_EXEC_FLAGS = -ldl
	TARGET_FLAGS = -shared -fPIC
	REGION_TEST_SO_FLAGS = -shared -fPIC

	PATH_SEPARATOR = /
endif

MKDIR = $(UTILS_BIN_PATH)mkdir$(EXT_UTILS)
RM    = $(UTILS_BIN_PATH)rm$(EXT_UTILS)
MAKE = $(UTILS_BIN_PATH)make$(EXT_UTILS)

CC = gcc

SRC       = src
TARGETS   = $(SRC)$(PATH_SEPARATOR)targets
INCLUDE   = $(SRC)$(PATH_SEPARATOR)include

BUILD = .build
OBJ   = $(BUILD)$(PATH_SEPARATOR)obj
BIN   = $(BUILD)$(PATH_SEPARATOR)bin
LIB   = $(BUILD)$(PATH_SEPARATOR)lib

FRAMEWORK_TAG = rt
FRAMEWORK_PATH = $(SRC)$(PATH_SEPARATOR)framework
FRAMEWORK_C    = $(FRAMEWORK_PATH)$(PATH_SEPARATOR)$(FRAMEWORK_TAG).c
FRAMEWORK_EXEC = $(BIN)$(PATH_SEPARATOR)$(FRAMEWORK_TAG)-exec

REGION_TEST_TAG = region-test
REGION_TEST_C = $(SRC)$(PATH_SEPARATOR)lib$(PATH_SEPARATOR)$(REGION_TEST_TAG).c
REGION_TEST_SO = $(LIB)$(PATH_SEPARATOR)$(REGION_TEST_TAG).$(EXT_SOBJ)

$(BUILD):
	$(MKDIR) -p .build

$(OBJ): $(BUILD)
	$(MKDIR) -p $(OBJ)

$(BIN): $(BUILD)
	$(MKDIR) -p $(BIN)

$(LIB): $(BUILD)
	$(MKDIR) -p $(LIB)

$(REGION_TEST_SO): $(LIB)
	$(CC) $(REGION_TEST_SO_FLAGS) $(REGION_TEST_C) -o $(REGION_TEST_SO)

TARGETS_SRCS := $(wildcard $(TARGETS)/*.c)

$(OBJ)$(PATH_SEPARATOR)%.$(EXT_SOBJ): $(TARGETS)$(PATH_SEPARATOR)%.c $(OBJ)
	$(CC) $(TARGET_FLAGS) -o $@ $<

TARGETS_SOS := $(patsubst $(TARGETS)$(PATH_SEPARATOR)%.c,$(OBJ)$(PATH_SEPARATOR)%.$(EXT_SOBJ),$(TARGETS_SRCS))

$(FRAMEWORK_EXEC): $(BUILD) $(OBJ) $(BIN)
	$(CC) $(FRAMEWORK_C) $(FRAMEWORK_EXEC_FLAGS) $(FRAMEWORK_PATH)$(PATH_SEPARATOR)main.c -o $(FRAMEWORK_EXEC)

build: $(FRAMEWORK_EXEC) $(REGION_TEST_SO) $(OBJ) $(BIN) $(TARGETS_SOS)

run: build
	./$(FRAMEWORK_EXEC)

clean:
	$(RM) -rf $(BUILD)
