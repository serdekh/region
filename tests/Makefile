ifeq ($(OS),Windows_NT)
	UTILS_BIN_PATH =
	
	EXT_EXEC = exe
	EXT_SOBJ = dll
	EXT_UTILS = .$(EXT_EXEC)
	
	FRAMEWORK_EXEC_FLAGS = -DREGION_BUILD
	TARGET_FLAGS = -shared -DREGION_BUILD
	REGION_TEST_SO_FLAGS = -shared -DREGION_BUILD
else
	UTILS_BIN_PATH =

	EXT_EXEC =
	EXT_SOBJ = so
	EXT_UTILS = 

	FRAMEWORK_EXEC_FLAGS = -ldl
	TARGET_FLAGS = -shared -fPIC
	REGION_TEST_SO_FLAGS = -shared -fPIC
endif

MKDIR = $(UTILS_BIN_PATH)mkdir$(EXT_UTILS)
RM    = $(UTILS_BIN_PATH)rm$(EXT_UTILS)
MAKE = $(UTILS_BIN_PATH)make$(EXT_UTILS)

CC = gcc

SRC       = src
TARGETS   = $(SRC)/targets
INCLUDE   = $(SRC)/include

BUILD = .build
OBJ   = $(BUILD)/obj
BIN   = $(BUILD)/bin
LIB   = $(BUILD)/lib

FRAMEWORK_TAG = rt
FRAMEWORK_PATH = $(SRC)/framework
FRAMEWORK_C    = $(FRAMEWORK_PATH)/$(FRAMEWORK_TAG).c
FRAMEWORK_EXEC = $(BIN)/$(FRAMEWORK_TAG)-exec

REGION_TEST_TAG = region-test
REGION_TEST_C = $(SRC)/lib/$(REGION_TEST_TAG).c
REGION_TEST_SO = $(LIB)/$(REGION_TEST_TAG).$(EXT_SOBJ)

$(BUILD):
	$(MKDIR) -p .build

$(OBJ): $(BUILD)
	$(MKDIR) -p $(OBJ)

$(BIN): $(BUILD)
	$(MKDIR) -p $(BIN)

$(LIB): $(BUILD)
	$(MKDIR) -p $(LIB)

$(REGION_TEST_SO): $(LIB)
	$(CC) $(REGION_TEST_SO_FLAGS) $(REGION_TEST_C) -o $(REGION_TEST_SO)

TARGETS_SRCS := $(wildcard $(TARGETS)/*.c)

$(OBJ)/%.$(EXT_SOBJ): $(TARGETS)/%.c $(OBJ)
	$(CC) $(TARGET_FLAGS) -o $@ $<

TARGETS_SOS := $(patsubst $(TARGETS)/%.c,$(OBJ)/%.$(EXT_SOBJ),$(TARGETS_SRCS))

$(FRAMEWORK_EXEC): $(BUILD) $(OBJ) $(BIN)
	$(CC) $(FRAMEWORK_C) $(FRAMEWORK_EXEC_FLAGS) $(FRAMEWORK_PATH)/main.c -o $(FRAMEWORK_EXEC)

build: $(FRAMEWORK_EXEC) $(REGION_TEST_SO) $(OBJ) $(BIN) $(TARGETS_SOS)

run: build
	./$(FRAMEWORK_EXEC)

clean:
	$(RM) -rf $(BUILD)
